# Single source of truth for CI / local headless tool pins.
# Sourced by .github/workflows/checks.yml (readymade-acceptance) and install helpers.
#
# Godot: project.godot declares config/features "4.7"; docs/developer-guide/local-dev.md
# says Godot 4.7.x (harness historically verified on 4.7.1-rc2). Pin the latest
# stable in that line: 4.7.2-stable.
#
# LimboAI: synesyn_client/addons/limboai/version.txt and local-dev.md pin v1.8.0.
# Upstream only publishes a GDExtension artifact built against Godot 4.6
# (limboai+v1.8.0.gdextension-4.6.zip). There is no gdextension-4.7 zip as of
# LimboAI v1.8.1 — custom Godot 4.7.2 editors with LimboAI as a module exist, but
# this repo uses the stock editor + GDExtension layout. Flag for owner: whether
# to stay on gdextension-4.6 under Godot 4.7.x, or switch CI to LimboAI's
# godot-4.7.2 module editor so the LimboAI build label matches Godot's minor.

GODOT_VERSION=4.7.2-stable
GODOT_ZIP_NAME=Godot_v4.7.2-stable_linux.x86_64.zip
GODOT_DOWNLOAD_URL=https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_linux.x86_64.zip
GODOT_SHA256=cadd3204e728a35d3f13adb7fd0d7902636b79f6b95c40c265eb73b6c35329e4

LIMBOAI_VERSION=v1.8.0
LIMBOAI_ZIP_NAME=limboai+v1.8.0.gdextension-4.6.zip
LIMBOAI_DOWNLOAD_URL=https://github.com/limbonaut/limboai/releases/download/v1.8.0/limboai%2Bv1.8.0.gdextension-4.6.zip
LIMBOAI_SHA256=f95ef170ee41cb587cc720bdd1ea5f496ada1d4017456348c01f308495973c40
