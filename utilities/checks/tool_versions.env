# Recommended / tested-with builds for CI and local headless checks.
# Synesyn does NOT ship or bundle Godot or LimboAI — each user installs them.
# This file is the single source of truth for the versions CI tests against and
# that docs recommend. Sourced by .github/workflows/checks.yml
# (readymade-acceptance) and install helpers.
#
# Godot: project.godot declares config/features "4.7". Recommend the latest
# stable in that line that we build and test with: 4.7.2-stable.
# Download: https://godotengine.org/download/ or the GitHub release URL below.
#
# LimboAI: synesyn_client/addons/limboai/version.txt records v1.8.0. Recommend
# the GDExtension zip labeled for Godot 4.6 (limboai+v1.8.0.gdextension-4.6.zip).
# That build works under Godot 4.7.x; upstream has no gdextension-4.7 zip yet.
# Decision: stay on GDExtension 4.6 (not a LimboAI module editor build).
# Download: https://github.com/limbonaut/limboai/releases

GODOT_VERSION=4.7.2-stable
GODOT_ZIP_NAME=Godot_v4.7.2-stable_linux.x86_64.zip
GODOT_DOWNLOAD_URL=https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_linux.x86_64.zip
GODOT_SHA256=cadd3204e728a35d3f13adb7fd0d7902636b79f6b95c40c265eb73b6c35329e4

LIMBOAI_VERSION=v1.8.0
LIMBOAI_ZIP_NAME=limboai+v1.8.0.gdextension-4.6.zip
LIMBOAI_DOWNLOAD_URL=https://github.com/limbonaut/limboai/releases/download/v1.8.0/limboai%2Bv1.8.0.gdextension-4.6.zip
LIMBOAI_SHA256=f95ef170ee41cb587cc720bdd1ea5f496ada1d4017456348c01f308495973c40
