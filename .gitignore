# Synesyn repository ignores.
#
# Paths are relative to the repository root (this directory).

# ---------------------------------------------------------------- credentials
# Real keys stay on the developer's machine. Copy config.example.cfg to
# config.cfg and fill it in; the copy is never tracked.
synesyn_client/addons/syntree/config.cfg

# Machine-specific harness/agent configuration.
docs/technical-review/run_specs/devagent_config.json

# --------------------------------------------------------------- Godot client
# Engine cache and import artefacts, regenerated on open.
.godot/
synesyn_client/.godot/

# Export presets carry local output paths and occasionally credentials.
export_presets.cfg

# --------------------------------------------------------------------- Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------ build artefacts
# Release output and packaged bundles do not belong in version control.
ExportedPackage/
Exports/
dist/
build/
*.egg-info/

# PyInstaller spec is regenerated by the packaging script and embeds absolute
# local paths.
services/synesyn_hub/packaging/synesyn_hub.spec

# Bundled model weights: large, separately licensed, fetched at setup time.
services/synesyn_hub/models/

# ------------------------------------------------------------- runtime output
# Hub process logs. A packaged build logs next to its service, which is why this
# path exists at all; running from source now logs only to the workspace, so an
# in-tree copy here is residue from before that was fixed.
services/hub/
*.log

# Session transcripts. Canonical location is Documents/Synesyn per ADR 0014, and
# the resolver no longer falls back into the project, so anything appearing here
# is residue. Kept as a guard against an older build.
synesyn_client/ScenSyn/story_logs/

# Local debug captures and speech-synthesis scratch output.
synesyn_client/debug/
synesyn_client/ScenSyn/tts_debug/

# Microphone captures. RuntimeConfig writes these to Documents/Synesyn per
# ADR 0014, so an in-tree copy is pre-migration residue and may contain a real
# participant's voice.
synesyn_client/addons/syntree_voice/recordings/

# ComfyUI scratch output, occasionally saved into the project by mistake.
**/ComfyUI_temp_*

# Agent-generated file backups.
synesyn_client/_agent_backups/

# ------------------------------------------------------ third-party binaries
# LimboAI is a GDExtension: its bin/ directory holds ~130 MB of precompiled
# libraries for Windows, Linux and macOS plus the .gdextension descriptor.
# These are published upstream, so the repository records the pinned version in
# addons/limboai/version.txt and contributors install the addon themselves.
# See docs/developer-guide/local-dev.md for setup.
synesyn_client/addons/limboai/bin/

# --------------------------------------------------------------- content pack
# Story Stage sprite library (~545 MB) ships as optional content packs rather
# than in the repository. utilities/assets/story_stage_sprites.py builds and
# installs them; see docs/user-guide/story-stage-sprites.md.
synesyn_client/ScenSyn/story_stage/sprites/

# ------------------------------------------------------- editor / OS artefacts
*.tmp
*.TMP
*.bak
*~
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# Office lock files embed the local username and profile path.
.~lock.*#
~$*

# Working notes that are not part of the project record.
*_scratchpad.docx

# Generated documentation site. Built from docs/ by mkdocs; never committed.
/site/

# --------------------------------------------------------- withheld pilot content
# Scenario authored for a specific client pilot. Kept out of distribution as a
# commercial matter, not a technical one; the shipped Workshop Catalyst default
# is karlsruhe_library_future_design. Remove this line if the pilot content is
# ever cleared for release.
synesyn_client/ScenSyn/session_types/workshop_catalyst/scenarios/weight_of_decision_glp1_policy_triage.txt

# ------------------------------------------------- unpublished authored source texts
# Reference material behind ReadyMade: a performance lecture and an unpublished
# scholarly draft. Neither is read at runtime. Withheld because the paper is
# pre-publication and the repository's MIT grant is written for code, not for
# scholarly text. The vocabulary they define is recorded in ADR 0024.
synesyn_client/readymade/FoundConcepts_Draft_00.txt
synesyn_client/readymade/kernel_lecture.txt
