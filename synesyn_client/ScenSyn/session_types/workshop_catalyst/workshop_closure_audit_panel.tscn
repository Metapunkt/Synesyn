[gd_scene format=3 uid="uid://b7kn3pyhsgerv"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_audit_step"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(0.945, 0.949, 0.972, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="WorkshopClosureAuditPanel" type="VBoxContainer"]
theme_override_constants/separation = 10

[node name="AuditHeadingRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="AuditHeading" type="Label" parent="AuditHeadingRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Closure audit"
tooltip_text = "Checks the map for things the group never looked at. Six steps: name the decision, explain each near-empty quadrant, rate how much that gap matters, read the pile-up in the busiest quadrant, record anything you are leaving unresolved on purpose, and pick one move to close the biggest gap. Press Suggest answers to have the model draft all six from the claims on the map. You accept, edit or discard each draft, and only what you accept is kept."

[node name="AuditSuggestButton" type="Button" parent="AuditHeadingRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 11
tooltip_text = "Asks the model to draft answers for the steps below, using the claims on the map. Each draft is labelled and changes nothing until you accept it. You can edit or discard any of them."
text = "Suggest answers"

[node name="AuditHideButton" type="Button" parent="AuditHeadingRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 11
tooltip_text = "Closes this panel. Everything you have entered is kept and comes back when you reopen it."
text = "Hide"

[node name="AuditSuggestStatus" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = ""
autowrap_mode = 2

[node name="AuditGateStatus" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Not started."
autowrap_mode = 2
tooltip_text = "What is still missing before this audit counts as done. Every near-empty quadrant needs a reason, because an empty quadrant looks the same whether nobody asked, nobody knows, or there was nothing there in the first place."

[node name="OrientStep" type="PanelContainer" parent="."]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_audit_step")

[node name="OrientBox" type="VBoxContainer" parent="OrientStep"]
layout_mode = 2

[node name="OrientLabel" type="Label" parent="OrientStep/OrientBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "0. Orient the claims"
autowrap_mode = 2
tooltip_text = "Numbered zero because it comes before the audit rather than being part of it. The steps below all read how claims are spread across the four quadrants, so enough claims need a tag first. You can skip tagging and run the session without it. But if you run the audit on an untagged map, it will report that nothing is missing only because it cannot see anything."

[node name="OrientStatus" type="Label" parent="OrientStep/OrientBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "No claims oriented yet."
autowrap_mode = 2

[node name="DecisionStep" type="PanelContainer" parent="."]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_audit_step")

[node name="DecisionBox" type="VBoxContainer" parent="DecisionStep"]
layout_mode = 2

[node name="DecisionLabel" type="Label" parent="DecisionStep/DecisionBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "1. The decision under audit"
autowrap_mode = 2
tooltip_text = "Type the decision this session is working towards. Asking whether the map is balanced gets you nowhere on its own. Asking whether it is balanced enough to settle a particular decision does, so name the decision."

[node name="DecisionRow" type="HBoxContainer" parent="DecisionStep/DecisionBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="DecisionInput" type="LineEdit" parent="DecisionStep/DecisionBox/DecisionRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "What is this session deciding?"

[node name="DecisionSaveButton" type="Button" parent="DecisionStep/DecisionBox/DecisionRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "Set"

[node name="DecisionSuggestion" type="VBoxContainer" parent="DecisionStep/DecisionBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="AbsenceStep" type="PanelContainer" parent="."]
layout_mode = 2
