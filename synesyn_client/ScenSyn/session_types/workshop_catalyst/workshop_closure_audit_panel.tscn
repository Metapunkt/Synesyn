theme_override_constants/separation = 6

[node name="ConcentrationLabel" type="Label" parent="ConcentrationStep/ConcentrationBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "3. What the pile-up in the busiest quadrant means"
autowrap_mode = 2
tooltip_text = "A lopsided map can mean two opposite things. Either the group is focused on what actually matters, or it has stopped looking anywhere else. Nothing in the map tells you which, so pick the one that matches what actually happened in the session."

[node name="ConcentrationTarget" type="Label" parent="ConcentrationStep/ConcentrationBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "No dominant quadrant yet."
autowrap_mode = 2

