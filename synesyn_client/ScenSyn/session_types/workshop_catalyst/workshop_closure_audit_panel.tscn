theme_override_constants/separation = 6

[node name="AbsenceLabel" type="Label" parent="AbsenceStep/AbsenceBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "2. Why each near-empty quadrant is empty, and how much that matters"
autowrap_mode = 2
tooltip_text = "Pick the kind of gap first, then rate it. Do it in that order, because you cannot rate a gap before you know what kind it is."

[node name="AbsenceList" type="VBoxContainer" parent="AbsenceStep/AbsenceBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="ConcentrationStep" type="PanelContainer" parent="."]
