[node name="GraphSelectedLabel" type="Label" parent="MapBodySplit/MapBodyPane/MapGraphReview"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Select a map node to review."
autowrap_mode = 2

[node name="GraphReviewAcceptedButton" type="Button" parent="MapBodySplit/MapBodyPane/MapGraphReview"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Accept the selected claim as-is. Required before it can be included in a Commit."
text = "Accept"

[node name="GraphReviewEditedButton" type="Button" parent="MapBodySplit/MapBodyPane/MapGraphReview"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Accept the selected claim with facilitator edits to its wording."
text = "Edit"

[node name="GraphReviewRejectedButton" type="Button" parent="MapBodySplit/MapBodyPane/MapGraphReview"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Reject the selected claim. Kept for the record but excluded from commits."
text = "Reject"

[node name="GraphReviewDeferredButton" type="Button" parent="MapBodySplit/MapBodyPane/MapGraphReview"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Postpone review of the selected claim for now."
text = "Defer"

[node name="MapLowerPane" type="VBoxContainer" parent="MapBodySplit"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.85
theme_override_constants/separation = 2

[node name="MapFooterRow" type="HBoxContainer" parent="MapBodySplit/MapLowerPane"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="RelationshipStatus" type="Label" parent="MapBodySplit/MapLowerPane/MapFooterRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Typed connections: none"
autowrap_mode = 2
tooltip_text = "How many typed relationships (e.g. causes, contradicts, supports) the specialists proposed or the facilitator drew between claims on the Graph view."

[node name="SymbolicInsightsLabel" type="Label" parent="MapBodySplit/MapLowerPane/MapFooterRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Symbolic checks: none flagged"
autowrap_mode = 2
tooltip_text = "No contradictions, causal chains, or evidence gaps detected yet."

[node name="ClosureAuditToggle" type="CheckButton" parent="MapBodySplit/MapLowerPane/MapFooterRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
button_pressed = false
text = "Closure audit"
tooltip_text = "Tags each claim with where it sits in time: something you were handed, something you expect, something you keep doing, or something you are turning into. The Causes and Effects columns only cover the first two, so this is where you check what the group skipped. Optional. Claims without a tag are still valid."

[node name="SuggestOrientationsButton" type="Button" parent="MapBodySplit/MapLowerPane/MapFooterRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 11
tooltip_text = "Asks the model to propose a tag for each untagged claim, or to say none fits. Nothing is tagged by pressing this: every proposal waits for you to accept it or pick something else."
text = "Suggest"

[node name="ViewsReviewButton" type="Button" parent="MapBodySplit/MapLowerPane/MapFooterRow"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 11
tooltip_text = "Shows the claims people read differently, worst disagreement first."
text = "Views"

[node name="MapCommitStatus" type="Label" parent="MapBodySplit/MapLowerPane/MapFooterRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Local draft — not committed."
autowrap_mode = 2
tooltip_text = "Whether this map has been saved to the Hub. A local draft is safe, but only you can see it until Commit succeeds."

[node name="ClosureCoverageLabel" type="Label" parent="MapBodySplit/MapLowerPane"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "Closure: no claims oriented yet."
autowrap_mode = 2
tooltip_text = "How many claims sit in each of the four quadrants, which one holds the most, and which hold none."

[node name="ClosureAuditHost" type="ScrollContainer" parent="MapBodySplit/MapLowerPane"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ViewsReviewPanel" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="ViewsReviewHeading" type="Label" parent="ViewsReviewPanel"]
layout_mode = 2
text = "Where people disagree"
tooltip_text = "Claims ordered by how far apart the recorded views are, most divided first. A single card only tells you whether one claim is disputed. This list tells you which claims the group turned out not to agree on."

[node name="ViewsRevealRow" type="HBoxContainer" parent="ViewsReviewPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RevealViewsButton" type="Button" parent="ViewsReviewPanel/ViewsRevealRow"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 11
tooltip_text = "Shows everyone's recorded views to the whole group. Until you press this, nobody sees anyone else's reading, including you, so each one is entered independently. It cannot be undone. Hiding views the group has already discussed would record a retraction that never happened."
text = "Reveal views"

[node name="ViewsRevealStatus" type="Label" parent="ViewsReviewPanel/ViewsRevealRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
text = "No views recorded yet."
autowrap_mode = 2

[node name="ViewsReviewScroll" type="ScrollContainer" parent="ViewsReviewPanel"]
custom_minimum_size = Vector2(0, 160)
layout_mode = 2

[node name="ViewsReviewList" type="VBoxContainer" parent="ViewsReviewPanel/ViewsReviewScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="MapPreviewPanel" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2

[node name="PreviewHeading" type="Label" parent="MapPreviewPanel"]
layout_mode = 2
tooltip_text = "A read-only technical preview of what Commit would send to the Hub: whether the draft is valid, the full resulting map document, and a summary of what changed. Nothing here is saved yet."
text = "Semantic impact preview"

[node name="MapPreviewText" type="TextEdit" parent="MapPreviewPanel"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
editable = false
wrap_mode = 1
tooltip_text = "Raw JSON: \"mutated\" shows whether this differs from the last commit, \"resulting_map\" is the full document Commit would save, and \"valid\" (further down) gates whether Commit is enabled."

[node name="ManualConnectRelationMenu" type="PopupMenu" parent="."]
unique_name_in_owner = true
