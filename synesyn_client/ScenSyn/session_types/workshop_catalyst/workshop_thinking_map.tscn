[gd_scene format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_map_column"]
content_margin_left = 10.0
content_margin_top = 8.0
content_margin_right = 10.0
content_margin_bottom = 8.0
bg_color = Color(0.93, 0.952, 0.98, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="WorkshopThinkingMap" type="VBoxContainer"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 2

[node name="MapToolbar" type="HBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="ColumnsViewButton" type="Button" parent="MapToolbar"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
button_pressed = true
tooltip_text = "Show claims grouped into Causes / Effects / Opportunities columns, one card per claim."
text = "Columns"

[node name="GraphViewButton" type="Button" parent="MapToolbar"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
tooltip_text = "Show claims as a node graph, with visible lines for the relationships between them (e.g. causes, contradicts)."
text = "Graph"

[node name="MapToolbarSpacer" type="Control" parent="MapToolbar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="MapContextToggle" type="CheckButton" parent="MapToolbar"]
unique_name_in_owner = true
visible = false
layout_mode = 2
button_pressed = false
text = "Specialist context"
tooltip_text = "When ON, the last committed map is fed back into the AI specialists' prompt on later turns, so their analysis builds on what you already reviewed. Pending suggestions are never sent. OFF by default, and safe to switch either way: turning it off just stops sending the map, it does not erase anything."

[node name="PreviewMapButton" type="Button" parent="MapToolbar"]
unique_name_in_owner = true
visible = false
layout_mode = 2
tooltip_text = "Click to open the Semantic impact preview below: a JSON diff of what committing right now would change (only Accepted/Edited items are included). Click again to close it. Nothing is saved to the Hub until you also press Commit."
text = "Preview"

[node name="CommitMapButton" type="Button" parent="MapToolbar"]
unique_name_in_owner = true
visible = false
layout_mode = 2
disabled = true
tooltip_text = "Sends the previewed map to the Hub as a new, immutable version. Enabled only after a valid Preview. Rejected/deferred items are excluded."
text = "Commit"

[node name="RetryMapCommitButton" type="Button" parent="MapToolbar"]
unique_name_in_owner = true
visible = false
layout_mode = 2
tooltip_text = "Retry the last failed commit using the same reviewed draft, without rebuilding the preview."
text = "Retry"

[node name="MapAddItemRow" type="HFlowContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 4

[node name="AddItemCategory" type="OptionButton" parent="MapAddItemRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Which column the claim belongs in. Picking it here is exact. Claims pulled out of the conversation are sorted by keyword, which sometimes lands them in the wrong column."
item_count = 3
popup/item_0/text = "Cause"
popup/item_0/id = 0
popup/item_1/text = "Effect"
popup/item_1/id = 1
popup/item_2/text = "Opportunity"
popup/item_2/id = 2
selected = 0

[node name="AddItemText" type="LineEdit" parent="MapAddItemRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Add a claim in your own words, then press Enter"
tooltip_text = "Type a cause, effect, or opportunity the specialists missed. It goes onto the map as Accepted straight away, since you wrote it yourself. Nothing reaches the Hub until you Preview and Commit."

[node name="AddItemButton" type="Button" parent="MapAddItemRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Put this claim on the map as your own, marked \"Added by facilitator\". You can Withdraw it again any time before it is committed."
text = "Add"

[node name="MapBodySplit" type="VSplitContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

