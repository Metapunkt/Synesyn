[node name="OutcomesHeading" type="Label" parent="MapBodySplit/MapBodyPane/MapColumns/OutcomesColumn/OutcomesBox"]
layout_mode = 2
text = "Outcomes"
tooltip_text = "Decisions, risks, owners and next steps. These are the claims you can send to the Session Record. They sit here rather than under Opportunities because an opportunity is something you could do, while an outcome is something you have settled."

