text = "Edit Sessions & Multi-Document Workflow"

[node name="EditSessionDescription" type="Label" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2
text = "ReadyMade now supports Edit Sessions – load multiple documents, choose a context mode (Single, All, Auto), and let the optimiser build the perfect context window for every AI request. Lazy-loading ensures only the chunks you actively need are loaded into memory, and the performance panel shows live metrics so you always know what's happening under the hood."
autowrap_mode = 3

[node name="AboutSeparator2b" type="HSeparator" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2

[node name="HowToLabel" type="Label" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2
theme_type_variation = &"HeaderMedium"
text = "How to Use ReadyMade"

[node name="HowToDescription" type="Label" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2
text = "Getting Started:

1. 🎯 Choose Your Mode
   Select your work focus (📱 Social Media, 🎭 Creative Writing, or 🎓 Academic) from the mode selector in the left panel. This adapts the entire interface to your current needs.

2. 📝 Create Tasks
   Click 'New Task' or press Ctrl+N to open the task dialog. The options will be tailored to your selected mode, showing only relevant formats and channels.

3. 🗂️ Manage Workplans  
   Use the Workplan Manager (Ctrl+W) to create, switch between, or organize different content strategies. Each workplan can focus on different projects or time periods.

4. 🤖 Process with AI
   Click 'Start Agent Batch' to let AI agents handle research, content generation, and optimization. Monitor progress and stop processing anytime with Ctrl+Q.

5. 📊 Review & Refine
   Use the Content Viewer tab to review AI-generated content, make edits, and see mode-specific analytics like engagement metrics or citation counts.

6. 📅 Schedule & Track
   Switch to the Calendar tab to visualize your content timeline, drag tasks between dates, and ensure you meet all deadlines."
autowrap_mode = 3

[node name="AboutSeparator3" type="HSeparator" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2

[node name="KeyboardShortcutsLabel" type="Label" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2
theme_type_variation = &"HeaderMedium"
text = "Essential Keyboard Shortcuts"

[node name="KeyboardShortcutsDescription" type="Label" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2
text = "• Ctrl+N - New Task
• Ctrl+S - Save Task List  
• Ctrl+O - Open Task List
• Ctrl+W - Workplan Manager
• Ctrl+R - Refresh Dashboard
• Ctrl+Q - Stop Agent Processing
• Ctrl+A - Select/Deselect All Tasks
• F5 - Refresh Dashboard"
autowrap_mode = 3

[node name="AboutSeparator4" type="HSeparator" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2

[node name="TipsLabel" type="Label" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2
theme_type_variation = &"HeaderMedium"
text = "Pro Tips"

[node name="TipsDescription" type="Label" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2
text = "• Switch modes frequently based on your current work focus - the interface adapts immediately
• Use task templates to quickly set up common content types with smart defaults
• Save different task lists for different campaigns or content themes
• Let AI agents run in the background while you work on other tasks
• Check the Calendar view regularly to balance your content workload
• Use the Scratchpad for quick notes and the Brainstorming tab for ideation sessions
• Mode-specific analytics help optimize content for your target audience and platform"
autowrap_mode = 3

