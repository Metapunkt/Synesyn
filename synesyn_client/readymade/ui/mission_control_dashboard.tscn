text = "What is ReadyMade?"

[node name="WhatIsDescription" type="Label" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2
text = "ReadyMade is an AI-powered content creation system built on the Godot Engine. It helps you manage your entire content strategy by turning a 6-month plan into a live, interactive workplan. The system combines human creativity with AI assistance to streamline content creation across different formats and platforms.

Key Features:
• 📱 Mode-Aware Interface - Adapts to Social Media, Creative Writing, or Academic Writing
• 🤖 AI Agent Processing - Automated research, synthesis, and content generation  
• 📅 Calendar Management - Visual scheduling and deadline tracking
• 📊 Content Analytics - Mode-specific quality metrics and insights
• 🎯 Task Templates - Pre-configured workflows for different content types
• 💾 Workplan Management - Save, load, and organize multiple content strategies"
autowrap_mode = 3

[node name="AboutSeparator2" type="HSeparator" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2

[node name="EditSessionHeader" type="Label" parent="HSplitContainer/MainTabContainer/About/AboutScrollContainer/AboutMarginContainer/AboutContent"]
layout_mode = 2
