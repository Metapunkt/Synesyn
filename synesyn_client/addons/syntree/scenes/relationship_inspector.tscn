[node name="EditActions" type="HBoxContainer" parent="MarginContainer/VBoxContainer/EditorContainer"]
layout_mode = 2

[node name="ReverseButton" type="Button" parent="MarginContainer/VBoxContainer/EditorContainer/EditActions"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Reverse the direction while preserving the edge id."
text = "Reverse"

[node name="DisconnectButton" type="Button" parent="MarginContainer/VBoxContainer/EditorContainer/EditActions"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Remove this relationship."
text = "Disconnect"

[node name="LegendSeparator" type="HSeparator" parent="MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="Legend" type="RichTextLabel" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
mouse_filter = 2
bbcode_enabled = true
text = "→ Structural (containment)   ⇢ Dependency (ordering)\n⇒ Evidential (support/conflict)   ↔ Semantic (meaning)"
fit_content = true

[node name="DisconnectConfirmation" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Disconnect relationship?"
dialog_text = "This removes the selected relationship. The connected nodes remain."
ok_button_text = "Disconnect"
