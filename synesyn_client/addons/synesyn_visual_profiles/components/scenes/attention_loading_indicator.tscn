[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://addons/synesyn_visual_profiles/components/scripts/semantic_panel.gd" id="1_panel"]
[ext_resource type="PackedScene" path="res://addons/synesyn_visual_profiles/components/scenes/semantic_status_badge.tscn" id="2_badge"]

[node name="AttentionLoadingIndicator" type="PanelContainer"]
script = ExtResource("1_panel")
